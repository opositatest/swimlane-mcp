{
  "name": "@opositatest/swimlane-mcp",
  "version": "0.0.0",
  "description": "Unofficial read-only MCP server for KanbanFlow: list a person's tasks across all your boards from any MCP client. Not affiliated with KanbanFlow.",
  "keywords": ["mcp", "model-context-protocol", "kanbanflow", "kanban", "swimlane", "claude", "tanstack-ai"],
  "homepage": "https://github.com/opositatest/swimlane-mcp",
  "bugs": "https://github.com/opositatest/swimlane-mcp/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opositatest/swimlane-mcp.git"
  },
  "license": "MIT",
  "author": {
    "name": "Opositatest",
    "url": "https://github.com/opositatest",
    "email": "dev@opositatest.com"
  },
  "contributors": [
    {
      "name": "Alfonso Lasa",
      "url": "https://github.com/rokkoo"
    }
  ],
  "type": "module",
  "main": "build/main.js",
  "bin": {
    "swimlane-mcp": "build/main.js"
  },
  "files": ["build", "README.md", "LICENSE"],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node build/main.js",
    "build": "rm -rf build && tsc -p tsconfig.build.json && chmod 755 build/main.js",
    "dev": "npx @modelcontextprotocol/inspector node --env-file-if-exists=.env --import tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "lint:check": "biome check",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "prepublishOnly": "npm run lint:check && npm test && npm run build",
    "bundle:extension": "node scripts/bundle-extension.mjs",
    "release": "release-it"
  },
  "dependencies": {
    "@tanstack/ai": "^0.63.0",
    "@tanstack/ai-mcp": "^0.6.0",
    "axios": "^1.20.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "release-it": "^21.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "tmp": "^0.2.7",
    "undici": "^7.30.0"
  }
}

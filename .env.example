# Required: API tokens of your boards, comma separated (one token per board:
# board menu > Settings > API & Webhooks). KANBANFLOW_API_KEY also works for a single board.
KANBANFLOW_API_KEYS=

# Optional: who "me" is — your email (recommended), full name or user id
KANBANFLOW_USER=

# Optional: override the API base URL (default: https://kanbanflow.com/api/v1)
KANBANFLOW_BASE_URL=
